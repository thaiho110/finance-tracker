<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/4.9.x/spotbugs/etc/findbugsfilter.xsd">

    <description>SpotBugs exclusion filter for Finance Tracker</description>

    <!-- Exclude test classes -->
    <Match>
        <Source name="~.*Test\.java"/>
    </Match>

    <!-- Exclude generated classes -->
    <Match>
        <Source name="~.*Application\.java"/>
    </Match>
</FindBugsFilter>
