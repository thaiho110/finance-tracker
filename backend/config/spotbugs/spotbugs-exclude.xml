<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/4.9.x/spotbugs/etc/findbugsfilter.xsd">

    <description>SpotBugs exclusion filter for Finance Tracker</description>

    <!-- Exclude test classes -->
    <Match>
        <Source name="~.*Test\.java"/>
    </Match>

    <!-- Exclude generated classes -->
    <Match>
        <Source name="~.*Application\.java"/>
    </Match>

    <!-- EI_EXPOSE_REP2: SpotBugs flags every constructor that stores an injected bean. The whole backend
         wires its collaborators through constructor injection (Lombok @RequiredArgsConstructor), and those
         beans are shared singletons by design, so this pattern is noise across the codebase. A per-class
         allowlist drifted out of date as features were added; exclude it project-wide instead. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Package name="~com\.financetracker\..*"/>
    </Match>

    <!-- EI_EXPOSE_REP: False positives for Spring-injected beans stored as fields -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Or>
            <Class name="com.financetracker.transaction.service.TransactionService"/>
        </Or>
    </Match>
    <!-- @ConfigurationProperties beans: Spring binds nested settings objects through their getters/setters -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Class name="com.financetracker.ocr.config.OcrProperties"/>
    </Match>

    <!-- JPA entities: Hibernate populates mapped columns by reflection, so SpotBugs cannot see the write and
         reports otherwise-read fields (e.g. Role.description, read in RoleResponse) as never written. -->
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
        <Package name="~com\.financetracker\..*\.model"/>
    </Match>
</FindBugsFilter>
