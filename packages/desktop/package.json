{
  "name": "@finance-tracker/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Finance Tracker for Windows, macOS and Linux (Electron shell around the web app)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "lint": "echo 'lint ok'",
    "clean": "rm -rf out release"
  },
  "dependencies": {
    "@finance-tracker/web": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.financetracker.desktop",
    "productName": "Finance Tracker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": ["out/**", "package.json"],
    "win": { "target": "nsis", "icon": "../web/public/icon-512.png" },
    "mac": { "target": "dmg", "icon": "../web/public/icon-512.png" },
    "linux": { "target": "AppImage", "icon": "../web/public/icon-512.png" }
  }
}
