# Required: JWT signing key, Base64 of 32+ random bytes
JWT_SECRET=replace-with-output-of-openssl-rand-base64-32

# Optional: PostgreSQL credentials (defaults match docker-compose)
DATABASE_URL=jdbc:postgresql://localhost:5432/finance_tracker
DATABASE_USER=ft_user
DATABASE_PASSWORD=ft_password

# First super admin (ADR-018): registering with this email creates a SUPER_ADMIN;
# an existing account with it is promoted at startup.
APP_SUPER_ADMIN_EMAIL=
