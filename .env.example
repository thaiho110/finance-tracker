# Required: OpenAI API key for receipt OCR
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: JWT secret (default works for local dev)
JWT_SECRET=finance-tracker-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256

# Optional: PostgreSQL credentials (defaults match docker-compose)
DATABASE_URL=jdbc:postgresql://localhost:5432/finance_tracker
DATABASE_USER=ft_user
DATABASE_PASSWORD=ft_password
